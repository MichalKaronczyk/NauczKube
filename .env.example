# Naucz Kubę — konfiguracja serwera.
# Skopiuj do .env i uzupełnij. Klucze NIGDY nie trafiają do przeglądarki.

# --- klucze API (wszystkie opcjonalne) ------------------------------------
# Groq: darmowy plan bez karty — https://console.groq.com/keys
GROQ_API_KEY=
# Zapas (opcjonalnie). W Mistralu wyłącz trenowanie na danych w panelu.
MISTRAL_API_KEY=
# Ostatnia deska ratunku: modele :free mają 50 zapytań dziennie.
OPENROUTER_API_KEY=

# --- tryby pracy -----------------------------------------------------------
# true = tylko lokalny model Bielik przez Ollamę, nic nie wychodzi z komputera.
# Zalecane dla szkół.
OFFLINE_ONLY=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=SpeakLeash/bielik-11b-v3.1-instruct:Q4_K_M

# true = gdy żaden provider nie odpowiada, Kuba mówi z wbudowanych szablonów,
# a wyjaśnienia ocenia heurystyka na słowach kluczowych z katalogu.
# Aplikacja działa wtedy bez internetu, ale język Kuby jest uboższy.
ALLOW_STUB_PROVIDER=true

# --- serwer ----------------------------------------------------------------
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
DATABASE_URL=sqlite:///./naucz_kube.db

# --- parametry dydaktyczne (domyślne wartości z specyfikacji) --------------
BKT_P_INIT=0.30
BKT_P_TRANSIT=0.20
BKT_P_GUESS=0.15
BKT_P_SLIP=0.10
BKT_MASTERY_THRESHOLD=0.95
EVIDENCE_SIMILARITY_THRESHOLD=0.85
TRANSFER_ERROR_PROBABILITY=0.30
HINT_AFTER_WRONG_MARKS=2
HINT_IDLE_SECONDS=90
SESSION_RATE_LIMIT=30
SOLO_RETENTION_DAYS=30
